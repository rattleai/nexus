{
  "consumer": {
    "name": "frontend"
  },
  "provider": {
    "name": "nxs-api"
  },
  "interactions": [
    {
      "description": "a request for health status",
      "providerState": "the API is running",
      "request": {
        "method": "GET",
        "path": "/api/v1/health/live"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "status": "ok"
        },
        "matchingRules": {
          "body": {
            "$.status": {
              "matchers": [{"match": "type"}]
            }
          }
        }
      }
    },
    {
      "description": "a request for jobs list",
      "providerState": "an authenticated user exists",
      "request": {
        "method": "GET",
        "path": "/api/v1/jobs",
        "headers": {
          "X-API-Key": "test-api-key"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "items": [],
          "total": 0,
          "page": 1,
          "page_size": 20,
          "pages": 0
        },
        "matchingRules": {
          "body": {
            "$.items": {"matchers": [{"match": "type"}]},
            "$.total": {"matchers": [{"match": "type"}]},
            "$.page": {"matchers": [{"match": "type"}]},
            "$.page_size": {"matchers": [{"match": "type"}]},
            "$.pages": {"matchers": [{"match": "type"}]}
          }
        }
      }
    },
    {
      "description": "a request for agent definitions",
      "providerState": "an authenticated user exists",
      "request": {
        "method": "GET",
        "path": "/api/v1/agents/definitions",
        "headers": {
          "X-API-Key": "test-api-key"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "items": [],
          "total": 0,
          "page": 1,
          "page_size": 20,
          "pages": 0
        },
        "matchingRules": {
          "body": {
            "$.items": {"matchers": [{"match": "type"}]},
            "$.total": {"matchers": [{"match": "type"}]}
          }
        }
      }
    },
    {
      "description": "a request for billing usage",
      "providerState": "an authenticated user exists",
      "request": {
        "method": "GET",
        "path": "/api/v1/billing/usage",
        "query": "days=30",
        "headers": {
          "X-API-Key": "test-api-key"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "period_days": 30,
          "total_requests": 0,
          "total_tokens": 0,
          "total_cost_usd": 0.0
        },
        "matchingRules": {
          "body": {
            "$.period_days": {"matchers": [{"match": "type"}]},
            "$.total_requests": {"matchers": [{"match": "type"}]}
          }
        }
      }
    },
    {
      "description": "a request for MCP discovery",
      "providerState": "the API is running",
      "request": {
        "method": "GET",
        "path": "/.well-known/mcp"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "name": "nxs",
          "capabilities": {}
        },
        "matchingRules": {
          "body": {
            "$.name": {"matchers": [{"match": "type"}]},
            "$.capabilities": {"matchers": [{"match": "type"}]}
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "2.0.0"
    }
  }
}
