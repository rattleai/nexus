[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.115,<1",
    "uvicorn[standard]>=0.34,<1",
    "pydantic[email]>=2.7,<3",
    "pydantic-settings>=2.7,<3",
    "httpx>=0.28,<1",
    "structlog>=24.4,<26",
{%- if include_db %}
    "sqlalchemy[asyncio]>=2.0,<3",
    "asyncpg>=0.30,<1",
    "alembic>=1.14,<2",
{%- endif %}
{%- if include_redis %}
    "redis>=5.2,<6",
{%- endif %}
{%- if include_celery %}
    "celery[redis]>=5.4,<6",
{%- endif %}
]

[project.optional-dependencies]
dev = [
    "pytest>=8,<9",
    "pytest-asyncio>=0.25,<1",
    "pytest-cov>=5.0,<6",
    "httpx>=0.28,<1",
    "ruff>=0.9,<1",
    "mypy>=1.8,<2",
]

[tool.hatch.build.targets.wheel]
packages = ["app"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]

[tool.ruff]
target-version = "py311"
line-length = 120

[tool.ruff.lint]
select = ["E", "F", "I", "N", "UP", "B", "SIM", "PIE", "RUF", "C4", "DTZ", "T20"]

[tool.ruff.lint.per-file-ignores]
"app/api/**/*.py" = ["B008"]
{%- if include_db %}
"app/db/migrations/**" = ["E501", "I001"]
{%- endif %}

[tool.mypy]
python_version = "3.11"
warn_return_any = true
warn_unused_configs = true
ignore_missing_imports = true
