services:
  api:
    build: .
    ports:
      - "127.0.0.1:{{ port }}:{{ port }}"
    env_file: .env
    environment:
      - PYTHONPATH=/app
{%- if include_db %}
      - DATABASE_URL=postgresql+asyncpg://${DB_USER:?Set DB_USER}:${DB_PASSWORD:?Set DB_PASSWORD}@db:5432/{{ python_package }}
{%- endif %}
{%- if include_db %}
    depends_on:
      db:
        condition: service_healthy
{%- endif %}
{%- if include_redis %}
      redis:
        condition: service_healthy
{%- endif %}
    command: >-
      sh -c "
{%- if include_db %}alembic upgrade head && {% endif %}uvicorn app.main:app --host 0.0.0.0 --port {{ port }} --proxy-headers"
    restart: unless-stopped
    stop_grace_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: "1.0"
{%- if include_db or include_redis %}
    networks:
      - proxy
{%- if include_db %}
      - data
{%- endif %}
{%- endif %}

{%- if include_db %}

  db:
    image: postgres:16-alpine
    ports:
      - "127.0.0.1:5434:5432"
    environment:
      POSTGRES_USER: ${DB_USER:?Set DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD:?Set DB_PASSWORD}
      POSTGRES_DB: {{ python_package }}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-app}"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped
    stop_grace_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - data
{%- endif %}

{%- if include_redis %}

  redis:
    image: redis:7-alpine
    ports:
      - "127.0.0.1:6380:6379"
    command: >-
      redis-server
      --maxmemory 128mb
      --maxmemory-policy allkeys-lru
      --requirepass ${REDIS_PASSWORD:-changeme}
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a ${REDIS_PASSWORD:-changeme} ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped
    stop_grace_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
{%- if include_db %}
      - data
{%- else %}
      - proxy
{%- endif %}
{%- endif %}

{%- if include_celery %}

  worker:
    build: .
    env_file: .env
    environment:
      - PYTHONPATH=/app
{%- if include_db %}
      - DATABASE_URL=postgresql+asyncpg://${DB_USER:?Set DB_USER}:${DB_PASSWORD:?Set DB_PASSWORD}@db:5432/{{ python_package }}
{%- endif %}
    depends_on:
      redis:
        condition: service_healthy
    command: celery -A app.workers.celery_app worker --loglevel=info
    restart: unless-stopped
    stop_grace_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - proxy
{%- if include_db %}
      - data
{%- endif %}

  beat:
    build: .
    env_file: .env
    environment:
      - PYTHONPATH=/app
    depends_on:
      redis:
        condition: service_healthy
    command: celery -A app.workers.celery_app beat --loglevel=info
    restart: unless-stopped
    stop_grace_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - proxy
{%- if include_db %}
      - data
{%- endif %}
{%- endif %}

{%- if include_db %}

volumes:
  pgdata:
{%- endif %}

{%- if include_db or include_redis %}

networks:
  proxy:
    driver: bridge
{%- if include_db %}
  data:
    driver: bridge
{%- endif %}
{%- endif %}
