{%- if include_redis %}
"""Redis connection pool."""

import redis.asyncio as aioredis

from app.config import settings

redis_pool = aioredis.from_url(
    settings.REDIS_URL,
    encoding="utf-8",
    decode_responses=True,
    socket_connect_timeout=5,
    socket_timeout=5,
    max_connections=20,
)
{%- endif %}
