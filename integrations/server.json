{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.cadprice/mcp-server",
  "title": "CADPrice MCP Server",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS platform with AI gateway, agent orchestration, billing, and file management. Provides tools for AI completion, agent execution, job management, file storage, billing, and team management.",
  "websiteUrl": "https://cadprice.com",
  "repository": {
    "url": "https://github.com/mngapps/cadprice",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "docker",
      "identifier": "ghcr.io/mngapps/cadprice-mcp:latest",
      "version": "1.0.0",
      "transport": [
        {
          "type": "stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "CADPRICE_API_KEY",
          "description": "Your CADPrice API key for authentication",
          "required": true
        },
        {
          "name": "CADPRICE_API_URL",
          "description": "API base URL (default: https://api.cadprice.com)",
          "required": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "transportType": "streamable-http",
      "url": "https://mcp.cadprice.com/mcp",
      "authorizationUrl": "https://api.cadprice.com/oauth/authorize",
      "tokenUrl": "https://api.cadprice.com/oauth/token"
    }
  ],
  "_meta": {
    "categories": ["saas", "ai-gateway", "agents", "billing", "developer-tools"],
    "features": [
      "AI completion via multi-provider gateway",
      "Agent orchestration (create, run, monitor agents)",
      "File upload/download/management",
      "Background job management",
      "Billing and usage tracking",
      "Team and webhook management"
    ]
  }
}
