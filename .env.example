# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── S3-compatible storage ─────────────────────────────
# Required for file upload/download. Leave empty to disable storage.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=uploads
S3_REGION=auto

# ── Application ───────────────────────────────────────
# IMPORTANT: Change SECRET_KEY before deploying to production.
# With DEBUG=false, the app will refuse to start with the default value.
SECRET_KEY=change-me-in-production
DEBUG=true
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
API_V1_PREFIX=/api/v1

# ── Rate limiting ─────────────────────────────────────
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ENDPOINTS=10
RATE_LIMIT_UPLOADS=20

# ── Request size limits ───────────────────────────────
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_SIZE_BYTES=52428800

# ── Caching ──────────────────────────────────────────
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300

# ── OpenTelemetry ────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cadprice
OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# ── User Authentication ─────────────────────────────
# Set AUTH_ENABLED=true to enable JWT/OAuth login alongside API key auth.
AUTH_ENABLED=false
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
