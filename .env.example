# ── Deployment ────────────────────────────────────────
# Domain name for TLS certificate provisioning (used by nginx and certbot)
DOMAIN=localhost
# Uvicorn worker processes per container (default 1; with replicas=2, total=2 workers)
WEB_CONCURRENCY=1
# Database backup retention in days
BACKUP_RETENTION_DAYS=30

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Required by docker-compose.prod.yml (set strong values for production)
DB_PASSWORD=
DB_USER=app
DB_NAME=app
# SSL mode for production DB connections. Set to "require" in production.
DATABASE_SSL_MODE=
# Sync URL for Celery workers. Leave empty to auto-derive from DATABASE_URL.
DATABASE_SYNC_URL=
# Read replica URL (optional, for read-write splitting). Leave empty to disable.
DATABASE_READ_URL=

# ── Redis ─────────────────────────────────────────────
# For docker-compose.prod.yml use: redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=redis://redis:6379/0
# Required by docker-compose.prod.yml — set a strong random value for production
REDIS_PASSWORD=

# ── S3-compatible storage ─────────────────────────────
# Required for file upload/download. Leave empty to disable storage.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=uploads
S3_REGION=auto

# ── Application ───────────────────────────────────────
# IMPORTANT: Change SECRET_KEY before deploying to production.
# With DEBUG=false, the app will refuse to start with the default value.
SECRET_KEY=change-me-in-production
# Dedicated key for data-at-rest encryption (BYOK keys, OAuth tokens, etc.).
# IMPORTANT: Set a unique value separate from SECRET_KEY so that JWT key rotation
# does not break encrypted data. Required in production (DEBUG=false).
ENCRYPTION_KEY=
# Dedicated key for webhook HMAC signatures. Falls back to SECRET_KEY if unset.
WEBHOOK_SIGNING_KEY=
# IMPORTANT: Set a separate ADMIN_KEY for admin endpoints. Do NOT reuse SECRET_KEY.
ADMIN_KEY=change-me-admin-key
DEBUG=true
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
API_V1_PREFIX=/api/v1

# ── Rate limiting ─────────────────────────────────────
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ENDPOINTS=10
RATE_LIMIT_UPLOADS=20

# ── Request size limits ───────────────────────────────
MAX_REQUEST_BODY_BYTES=1048576
MAX_UPLOAD_SIZE_BYTES=52428800

# ── Caching ──────────────────────────────────────────
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300

# ── OpenTelemetry ────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=saas-platform
OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# ── Email (Brevo / Sendinblue) ─────────────────────
# Required for sending verification, password-reset, and invitation emails.
# Leave BREVO_API_KEY empty to log emails to stdout instead (dev mode).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=SaaS Platform
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
# Base URL for links in emails (verification, password reset, etc.)
APP_BASE_URL=http://localhost:3000

# ── User Authentication ─────────────────────────────
# Set AUTH_ENABLED=true to enable JWT/OAuth login alongside API key auth.
AUTH_ENABLED=false
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT signing algorithm. RS256 (asymmetric) recommended for production.
# HS256 uses SECRET_KEY for signing (simpler, single-service only).
# RS256 uses JWT_PRIVATE_KEY/JWT_PUBLIC_KEY (supports multi-service verification).
# Generate RSA keys: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_ALGORITHM=RS256
# PEM-encoded RSA keys for RS256 JWT signing. Use \n for line breaks.
# Required in production when JWT_ALGORITHM=RS256. Falls back to HS256 in dev.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# OAuth Social Login (Google & GitHub)
# Create credentials at https://console.cloud.google.com/apis/credentials (Google)
# and https://github.com/settings/developers (GitHub).
# Leave empty to hide social login buttons in the UI.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── Billing (Stripe) ────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Mobile-First / PWA ─────────────────────────────
# Web Push (VAPID) — required for browser push notifications.
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_MAILTO=admin@cadprice.com

# Firebase Cloud Messaging (for native mobile push).
# Paste the entire Firebase service account JSON string.
FIREBASE_SERVICE_ACCOUNT_JSON=

# WebAuthn / FIDO2 (biometric authentication).
# RP_ID must match the domain (no port). ORIGIN is the full base URL.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CAD Price
WEBAUTHN_ORIGIN=http://localhost:3000

# CDN (optional). Set CDN_BASE_URL to serve static assets from a CDN.
CDN_BASE_URL=
# Image transform prefix for on-the-fly resizing (e.g. Cloudflare: /cdn-cgi/image/)
CDN_IMAGE_TRANSFORM_PREFIX=

# ── AI Gateway ───────────────────────────────────────
AI_ENABLED=true
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_TOKENS_PER_REQUEST=128000
AI_MAX_MESSAGES_PER_REQUEST=100
AI_MAX_MESSAGE_LENGTH=200000
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=3600
AI_DEFAULT_FALLBACK_ENABLED=true
RATE_LIMIT_AI_REQUESTS=60

# Margin multipliers — applied to raw token consumption
# Platform keys: platform bears provider cost, higher margin
# BYOK keys: tenant pays provider directly, lower infrastructure fee
AI_MARGIN_PLATFORM_KEYS=1.20
AI_MARGIN_BYOK_KEYS=1.05
AI_WALLET_LOW_BALANCE_THRESHOLD=1000

# ── AI Provider Keys (platform-managed) ─────────────
# Set keys for providers you want to offer via platform-managed routing.
# Tenants can also bring their own keys (BYOK).
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_GOOGLE_API_KEY=
AI_MISTRAL_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_QWEN_API_KEY=
AI_QWEN_API_BASE=
AI_ALEPH_ALPHA_API_KEY=
AI_XAI_API_KEY=

# ── RAG / Embedding Gateway ────────────────────────────
# Multi-provider embedding generation with caching
EMBEDDING_DEFAULT_PROVIDER=openai
EMBEDDING_DEFAULT_MODEL=text-embedding-3-small
EMBEDDING_COHERE_API_KEY=
EMBEDDING_VOYAGE_API_KEY=
EMBEDDING_LOCAL_URL=
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=86400

# Vector quantization for storage compression:
#   full   = float32 vector(1536) — highest accuracy, 6 KB/vector
#   half   = float16 halfvec(1536) — near-zero loss, 3 KB/vector (recommended)
#   binary = bit(1536) — 97% smaller, lower recall, 192 bytes/vector
VECTOR_QUANTIZATION=half

# Vector index type: hnsw (default) or diskann (requires pgvectorscale extension)
VECTOR_INDEX_TYPE=hnsw

# RAG Chunking Strategy: fixed_size, recursive, markdown, semantic, late
RAG_CHUNKING_STRATEGY=fixed_size
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_SEMANTIC_SIMILARITY_THRESHOLD=0.5

# RAG Re-ranking: none, cohere, cross_encoder
RAG_RERANKER_PROVIDER=none
RAG_RERANKER_MODEL=rerank-v3.5
RAG_RERANKER_API_KEY=
RAG_RERANKER_LOCAL_URL=
RAG_RERANKER_TOP_K=5

# ── Advanced RAG Features (all disabled by default) ────────
# Contextual retrieval (Anthropic method) — prepend document context to chunks
RAG_CONTEXTUAL_RETRIEVAL_ENABLED=false
RAG_CONTEXTUAL_MODEL=claude-haiku-4-5-20251001

# Parent-child document retrieval
RAG_PARENT_CHILD_ENABLED=false
RAG_PARENT_CHUNK_SIZE=2000
RAG_CHILD_CHUNK_SIZE=500

# Query routing and decomposition
RAG_QUERY_ROUTING_ENABLED=false
RAG_QUERY_DECOMPOSITION_ENABLED=false

# Semantic query cache
RAG_QUERY_CACHE_ENABLED=false
RAG_QUERY_CACHE_TTL_SECONDS=300
RAG_QUERY_CACHE_SIMILARITY_THRESHOLD=0.95

# Query analytics sampling rate (0.0-1.0)
RAG_QUERY_LOG_SAMPLE_RATE=0.1

# HyDE (Hypothetical Document Embeddings)
RAG_HYDE_ENABLED=false
RAG_HYDE_MODEL=claude-haiku-4-5-20251001

# Agentic RAG — multi-step retrieval with self-critique
RAG_AGENTIC_ENABLED=false
RAG_AGENTIC_MAX_ITERATIONS=3

# Graph RAG — knowledge graph extraction
RAG_GRAPH_ENABLED=false

# Late chunking (requires LOCAL/Jina embedding provider)
RAG_LATE_CHUNKING_ENABLED=false
