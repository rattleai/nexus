# ─────────────────────────────────────────────────────────────────────────────
# CADPrice Kubernetes Secrets Template
# ─────────────────────────────────────────────────────────────────────────────
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to secrets.yaml:
#        cp secrets.yaml.template secrets.yaml
#
#   2. Replace ALL placeholder values below with real credentials.
#
#   3. Apply to your cluster:
#        kubectl apply -f secrets.yaml
#
#   4. NEVER commit secrets.yaml to version control.
#      It is listed in .gitignore for safety.
#
# GENERATING SECRETS:
#   - Random hex keys:    openssl rand -hex 64
#   - RSA key pair:       openssl genrsa -out private.pem 2048
#                         openssl rsa -in private.pem -pubout -out public.pem
#
# PRODUCTION:
#   For production clusters, use SealedSecrets or an external secret manager
#   instead of plain Kubernetes secrets. See sealed-secrets.yaml for details.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: cadprice-secrets
  namespace: cadprice
  labels:
    app.kubernetes.io/part-of: cadprice
type: Opaque
stringData:
  # Database
  DATABASE_URL: "postgresql+asyncpg://app:CHANGEME@db-host:5432/cadprice?ssl=require"
  DATABASE_SYNC_URL: "postgresql://app:CHANGEME@db-host:5432/cadprice?sslmode=require"

  # Redis
  REDIS_URL: "redis://:CHANGEME@redis-host:6379/0"

  # Application secrets
  SECRET_KEY: "CHANGEME-generate-with-openssl-rand-hex-64"
  ENCRYPTION_KEY: "CHANGEME-generate-with-openssl-rand-hex-64"
  WEBHOOK_SIGNING_KEY: "CHANGEME-generate-with-openssl-rand-hex-32"
  ADMIN_KEY: "CHANGEME-generate-with-openssl-rand-hex-32"

  # JWT asymmetric keys (PEM-encoded)
  JWT_PRIVATE_KEY: "CHANGEME-paste-rsa-private-key-pem"
  JWT_PUBLIC_KEY: "CHANGEME-paste-rsa-public-key-pem"

  # S3-compatible storage (Cloudflare R2)
  S3_ENDPOINT_URL: "CHANGEME"
  S3_ACCESS_KEY_ID: "CHANGEME"
  S3_SECRET_ACCESS_KEY: "CHANGEME"

  # Stripe billing
  STRIPE_SECRET_KEY: "CHANGEME"
  STRIPE_PUBLISHABLE_KEY: "CHANGEME"
  STRIPE_WEBHOOK_SECRET: "CHANGEME"

  # Email (Brevo / Sendinblue)
  BREVO_API_KEY: "CHANGEME"

  # OAuth
  OAUTH_GOOGLE_CLIENT_ID: "CHANGEME"
  OAUTH_GOOGLE_CLIENT_SECRET: "CHANGEME"
  OAUTH_GITHUB_CLIENT_ID: "CHANGEME"
  OAUTH_GITHUB_CLIENT_SECRET: "CHANGEME"

  # Web Push (VAPID)
  VAPID_PRIVATE_KEY: "CHANGEME"
  VAPID_PUBLIC_KEY: "CHANGEME"

  # Firebase Cloud Messaging
  FIREBASE_SERVICE_ACCOUNT_JSON: "CHANGEME"

  # AI provider API keys
  AI_OPENAI_API_KEY: "CHANGEME"
  AI_ANTHROPIC_API_KEY: "CHANGEME"
  AI_GOOGLE_API_KEY: "CHANGEME"
  AI_MISTRAL_API_KEY: "CHANGEME"
  AI_DEEPSEEK_API_KEY: "CHANGEME"
  AI_QWEN_API_KEY: "CHANGEME"
  AI_QWEN_API_BASE: "CHANGEME"
  AI_ALEPH_ALPHA_API_KEY: "CHANGEME"
