{
  "openapi": "3.0.0",
  "info": {
    "title": "Werk24 TechRead API",
    "description": "Engineering drawing intelligence API by Werk24 (W24 Service GmbH). Extracts structured manufacturing data from 2D technical drawings (PDF, TIFF, JPEG, PNG, BMP) using computer vision and AI.\n\nCapabilities: Automatically reads dimensions with tolerances, threads, bores, chamfers, radii, surface roughness symbols, GD&T (Feature Control Frames with datum references), material callouts, part designations, revision tables, BOMs, and general tolerance blocks. Returns pixel-precise bounding boxes and per-field confidence scores.\n\nWorkflow: Submit a drawing via the callback endpoint with a list of 'asks' specifying what data to extract. Results are delivered asynchronously via webhook callbacks. Each ask type targets a specific category of information.\n\nSupported formats: PDF, TIFF, JPEG, JP2 (JPEG 2000), PNG, BMP. Scanned documents should be 200+ DPI for reliable extraction.",
    "contact": {
      "url": "https://werk24.io"
    },
    "license": {
      "name": "commercial"
    },
    "version": "2.0.0",
    "x-cadprice-relevance": "Werk24 TechRead is critical for the CADPrice Drawing Intelligence layer. STEP files lack manufacturing metadata (tolerances, surface finish, material specs, GD&T) that significantly impacts manufacturing cost. Werk24 extracts this data from PDF drawings — complementing Luminarity's STEP geometry mining. Together they provide complete cost-driving inputs: Luminarity supplies volumes/surfaces/bores from 3D geometry, Werk24 supplies tolerances/material/finish from 2D drawings.",
    "x-pricing": {
      "base_plan": "EUR 990/month",
      "per_page": "EUR 0.85/page",
      "note": "Pricing as of 2024. Contact sales@werk24.io for volume pricing and enterprise plans."
    },
    "x-documentation": {
      "api_docs": "https://v2.docs.werk24.io",
      "json_schema_repo": "https://github.com/W24-Service-GmbH/werk24-json-schema",
      "python_sdk": "https://pypi.org/project/werk24/",
      "note": "The Python SDK (werk24 package) provides a higher-level client that handles authentication, WebSocket connections, and response parsing. The REST endpoint documented here is the lower-level callback-based interface."
    },
    "x-authentication": {
      "method": "Token-based with AWS Cognito",
      "header": "Authorization: Token [LICENSE_TOKEN]",
      "cognito": "Initial authentication via AWS Cognito to obtain a session token. The Python SDK handles this automatically.",
      "note": "License tokens are issued per account. Contact Werk24 for API access credentials."
    },
    "x-supported-formats": {
      "input_formats": ["PDF", "TIFF", "JPEG", "JP2", "PNG", "BMP"],
      "recommended_dpi": "200+ DPI for scanned documents",
      "note": "Best results with vector PDFs (CAD-exported). Scanned documents require sufficient resolution. Multi-page PDFs are supported — each page is treated as a separate drawing sheet."
    }
  },
  "servers": [
    {
      "url": "https://api.w24.co",
      "description": "Werk24 TechRead production API server"
    }
  ],
  "security": [
    {
      "tokenAuth": []
    }
  ],
  "tags": [
    {
      "name": "TechRead",
      "description": "Submit engineering drawings for AI-powered analysis and structured data extraction"
    }
  ],
  "paths": {
    "/techread/read-with-callback": {
      "post": {
        "tags": ["TechRead"],
        "operationId": "readWithCallback",
        "summary": "Submit drawing for analysis with webhook callback",
        "description": "Submits an engineering drawing (PDF, TIFF, image) for AI-powered analysis. Specify which data to extract via the 'asks' array. Results are delivered asynchronously to the provided callback URL.\n\nEach 'ask' targets a specific category of information. Multiple asks can be submitted in a single request — the system processes them in parallel and sends separate callback responses for each completed ask.\n\nProcessing time varies by drawing complexity and number of asks. Typical: 5-30 seconds per page.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/TechReadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Drawing accepted for processing. Results will be delivered via the callback URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TechReadAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request — unsupported file format, missing required fields, or malformed asks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed — invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-callback-response": {
          "description": "The callback URL receives POST requests with the extraction results. Each ask type produces a separate callback. The callback payload varies by ask type — see the schema definitions for AskMetaData, AskFeatures, AskInsights, etc.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallbackPayload"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "tokenAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Token-based authentication. Format: 'Token [LICENSE_TOKEN]'. Tokens are obtained via AWS Cognito authentication flow (handled automatically by the Python SDK)."
      }
    },
    "schemas": {
      "TechReadRequest": {
        "type": "object",
        "required": ["drawing", "asks", "callback_url"],
        "description": "Request to analyze an engineering drawing",
        "properties": {
          "drawing": {
            "type": "string",
            "format": "binary",
            "description": "The engineering drawing file (PDF, TIFF, JPEG, JP2, PNG, BMP)"
          },
          "asks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ask"
            },
            "description": "List of data extraction requests. Each ask specifies a category of information to extract from the drawing."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to receive extraction results via POST callbacks"
          }
        }
      },
      "Ask": {
        "type": "object",
        "required": ["ask_type"],
        "description": "A data extraction request specifying what information to extract from the drawing",
        "discriminator": {
          "propertyName": "ask_type"
        },
        "properties": {
          "ask_type": {
            "type": "string",
            "enum": [
              "AskMetaData",
              "AskFeatures",
              "AskInsights",
              "AskRedaction",
              "AskBalloons",
              "AskSheetImages",
              "AskViewImages"
            ],
            "description": "Type of data to extract"
          }
        }
      },
      "AskMetaData": {
        "allOf": [
          { "$ref": "#/components/schemas/Ask" },
          {
            "type": "object",
            "description": "Extract drawing metadata: part ID, designation, material callout, weight, general tolerances, surface roughness defaults, BOM (bill of materials), and revision table information.",
            "x-extracted-fields": [
              "drawing_id",
              "part_id",
              "designation",
              "general_tolerances",
              "default_roughness",
              "material",
              "weight",
              "bill_of_materials",
              "revision_table"
            ]
          }
        ]
      },
      "AskFeatures": {
        "allOf": [
          { "$ref": "#/components/schemas/Ask" },
          {
            "type": "object",
            "description": "Extract manufacturing features: dimensions with tolerances, threads (internal/external with pitch and class), bores (through/blind with depth), chamfers, radii, surface roughness symbols per surface, and GD&T (Feature Control Frames with datum references, geometric tolerance zones).",
            "x-extracted-fields": [
              "dimensions (nominal, upper_tolerance, lower_tolerance, unit)",
              "threads (type, pitch, class, diameter, handedness)",
              "bores (type, diameter, depth, through/blind)",
              "chamfers (angle, depth)",
              "radii (value)",
              "surface_roughness (Ra/Rz value, process, per surface)",
              "gdt_feature_control_frames (characteristic, tolerance_zone, datum_refs, material_condition)"
            ]
          }
        ]
      },
      "AskInsights": {
        "allOf": [
          { "$ref": "#/components/schemas/Ask" },
          {
            "type": "object",
            "description": "Extract manufacturing insights: bounding dimensions (overall L×W×H), volume estimates, recommended manufacturing methods (turning, milling, sheet metal, casting, etc.), and suggested secondary processes (heat treatment, surface treatment, etc.).",
            "x-extracted-fields": [
              "bounding_dimensions (length, width, height)",
              "estimated_volume",
              "manufacturing_methods",
              "secondary_processes"
            ]
          }
        ]
      },
      "AskRedaction": {
        "allOf": [
          { "$ref": "#/components/schemas/Ask" },
          {
            "type": "object",
            "description": "Redact sensitive information from the drawing: company logos, proprietary marks, confidential text blocks. Returns a redacted copy of the drawing.",
            "x-use-case": "Useful for sharing drawings with suppliers without revealing proprietary information"
          }
        ]
      },
      "AskBalloons": {
        "allOf": [
          { "$ref": "#/components/schemas/Ask" },
          {
            "type": "object",
            "description": "Extract numbered callout/balloon annotations from the drawing. Returns balloon numbers with their positions and associated feature references.",
            "x-use-case": "Links numbered callouts to specific features for inspection reports and quality documentation"
          }
        ]
      },
      "AskSheetImages": {
        "allOf": [
          { "$ref": "#/components/schemas/Ask" },
          {
            "type": "object",
            "description": "Generate thumbnail images of each drawing sheet. Useful for preview displays and document management.",
            "properties": {
              "max_width": {
                "type": "integer",
                "description": "Maximum thumbnail width in pixels"
              },
              "max_height": {
                "type": "integer",
                "description": "Maximum thumbnail height in pixels"
              }
            }
          }
        ]
      },
      "AskViewImages": {
        "allOf": [
          { "$ref": "#/components/schemas/Ask" },
          {
            "type": "object",
            "description": "Generate thumbnail images of individual drawing views (front, side, section, detail views). Each view is extracted and returned as a separate image.",
            "properties": {
              "max_width": {
                "type": "integer",
                "description": "Maximum thumbnail width in pixels"
              },
              "max_height": {
                "type": "integer",
                "description": "Maximum thumbnail height in pixels"
              }
            }
          }
        ]
      },
      "TechReadAccepted": {
        "type": "object",
        "description": "Confirmation that the drawing has been accepted for processing",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for this analysis request. Use this to correlate callback responses."
          },
          "status": {
            "type": "string",
            "enum": ["accepted", "processing"],
            "description": "Request acceptance status"
          },
          "asks_received": {
            "type": "integer",
            "description": "Number of asks that will be processed"
          }
        }
      },
      "CallbackPayload": {
        "type": "object",
        "description": "Payload delivered to the callback URL when an ask is completed. Each ask type produces a separate callback.",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "The request ID from the original submission"
          },
          "ask_type": {
            "type": "string",
            "enum": [
              "AskMetaData",
              "AskFeatures",
              "AskInsights",
              "AskRedaction",
              "AskBalloons",
              "AskSheetImages",
              "AskViewImages"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["completed", "error"],
            "description": "Whether the ask was processed successfully"
          },
          "data": {
            "oneOf": [
              { "$ref": "#/components/schemas/MetaDataResult" },
              { "$ref": "#/components/schemas/FeaturesResult" },
              { "$ref": "#/components/schemas/InsightsResult" },
              { "$ref": "#/components/schemas/RedactionResult" },
              { "$ref": "#/components/schemas/BalloonsResult" },
              { "$ref": "#/components/schemas/SheetImagesResult" },
              { "$ref": "#/components/schemas/ViewImagesResult" }
            ],
            "description": "Extraction results (schema varies by ask_type)"
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "Error details if status is 'error'",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "MetaDataResult": {
        "type": "object",
        "description": "Extracted drawing metadata",
        "properties": {
          "drawing_id": {
            "type": "string",
            "nullable": true,
            "description": "Drawing number/ID from the title block"
          },
          "part_id": {
            "type": "string",
            "nullable": true,
            "description": "Part number from the title block"
          },
          "designation": {
            "type": "string",
            "nullable": true,
            "description": "Part designation/name",
            "example": "Adapter Flange"
          },
          "material": {
            "$ref": "#/components/schemas/MaterialCallout"
          },
          "weight": {
            "type": "object",
            "nullable": true,
            "properties": {
              "value": {
                "type": "number",
                "description": "Weight value"
              },
              "unit": {
                "type": "string",
                "description": "Weight unit (kg, g, lb)",
                "example": "kg"
              },
              "confidence": {
                "$ref": "#/components/schemas/Confidence"
              }
            }
          },
          "general_tolerances": {
            "type": "object",
            "nullable": true,
            "description": "General tolerance class per ISO 2768 or equivalent",
            "properties": {
              "standard": {
                "type": "string",
                "description": "Tolerance standard (e.g., 'ISO 2768')",
                "example": "ISO 2768"
              },
              "class_linear": {
                "type": "string",
                "description": "Linear tolerance class (f=fine, m=medium, c=coarse, v=very coarse)",
                "example": "m"
              },
              "class_angular": {
                "type": "string",
                "description": "Angular tolerance class",
                "example": "K"
              },
              "confidence": {
                "$ref": "#/components/schemas/Confidence"
              }
            }
          },
          "default_roughness": {
            "type": "object",
            "nullable": true,
            "description": "Default surface roughness specified in the title block",
            "properties": {
              "parameter": {
                "type": "string",
                "enum": ["Ra", "Rz"],
                "description": "Roughness parameter type"
              },
              "value": {
                "type": "number",
                "description": "Roughness value in micrometers"
              },
              "confidence": {
                "$ref": "#/components/schemas/Confidence"
              }
            }
          },
          "bill_of_materials": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/BOMEntry"
            },
            "description": "Bill of materials if present on the drawing"
          },
          "revision_table": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/RevisionEntry"
            },
            "description": "Revision history from the drawing"
          }
        }
      },
      "MaterialCallout": {
        "type": "object",
        "nullable": true,
        "description": "Material specification extracted from the drawing",
        "properties": {
          "raw_text": {
            "type": "string",
            "description": "The material text as written on the drawing",
            "example": "1.4301 (X5CrNi18-10)"
          },
          "standard": {
            "type": "string",
            "nullable": true,
            "description": "Material standard (DIN, ASTM, EN, JIS, etc.)",
            "example": "EN 10088-3"
          },
          "grade": {
            "type": "string",
            "nullable": true,
            "description": "Material grade/designation",
            "example": "1.4301"
          },
          "common_name": {
            "type": "string",
            "nullable": true,
            "description": "Common material name",
            "example": "AISI 304"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          }
        }
      },
      "BOMEntry": {
        "type": "object",
        "description": "A single entry in the bill of materials",
        "properties": {
          "position": {
            "type": "integer",
            "description": "Item/position number"
          },
          "part_id": {
            "type": "string",
            "nullable": true,
            "description": "Part number"
          },
          "designation": {
            "type": "string",
            "nullable": true,
            "description": "Part name/designation"
          },
          "quantity": {
            "type": "integer",
            "nullable": true,
            "description": "Required quantity"
          },
          "material": {
            "type": "string",
            "nullable": true,
            "description": "Material specification"
          }
        }
      },
      "RevisionEntry": {
        "type": "object",
        "description": "A revision table entry",
        "properties": {
          "revision": {
            "type": "string",
            "description": "Revision letter or number"
          },
          "date": {
            "type": "string",
            "nullable": true,
            "description": "Revision date"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Change description"
          },
          "author": {
            "type": "string",
            "nullable": true,
            "description": "Person who made the change"
          }
        }
      },
      "FeaturesResult": {
        "type": "object",
        "description": "Extracted manufacturing features from the drawing",
        "properties": {
          "dimensions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dimension"
            },
            "description": "All dimensions with tolerances"
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Thread"
            },
            "description": "Thread specifications"
          },
          "bores": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bore"
            },
            "description": "Bore/hole features"
          },
          "chamfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chamfer"
            },
            "description": "Chamfer features"
          },
          "radii": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Radius"
            },
            "description": "Radius features"
          },
          "surface_roughness": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SurfaceRoughness"
            },
            "description": "Per-surface roughness symbols"
          },
          "gdt_frames": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeatureControlFrame"
            },
            "description": "GD&T Feature Control Frames"
          }
        }
      },
      "Dimension": {
        "type": "object",
        "description": "A dimension with optional tolerances, extracted from the drawing",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reference ID for cross-Ask linking"
          },
          "nominal": {
            "type": "number",
            "description": "Nominal dimension value",
            "example": 25.0
          },
          "upper_tolerance": {
            "type": "number",
            "nullable": true,
            "description": "Upper tolerance deviation (+ value)",
            "example": 0.05
          },
          "lower_tolerance": {
            "type": "number",
            "nullable": true,
            "description": "Lower tolerance deviation (- value)",
            "example": -0.05
          },
          "fit_designation": {
            "type": "string",
            "nullable": true,
            "description": "ISO fit designation (e.g., H7, g6, H7/g6)",
            "example": "H7"
          },
          "unit": {
            "type": "string",
            "default": "mm",
            "description": "Unit of measurement"
          },
          "type": {
            "type": "string",
            "enum": ["linear", "diameter", "radius", "angular"],
            "description": "Dimension type"
          },
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          }
        }
      },
      "Thread": {
        "type": "object",
        "description": "Thread specification extracted from the drawing",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reference ID for cross-Ask linking"
          },
          "designation": {
            "type": "string",
            "description": "Full thread designation as written",
            "example": "M10x1.5-6H"
          },
          "type": {
            "type": "string",
            "enum": ["metric", "unified_coarse", "unified_fine", "pipe", "trapezoidal", "other"],
            "description": "Thread type/standard"
          },
          "diameter": {
            "type": "number",
            "description": "Nominal thread diameter in mm",
            "example": 10.0
          },
          "pitch": {
            "type": "number",
            "nullable": true,
            "description": "Thread pitch in mm",
            "example": 1.5
          },
          "class": {
            "type": "string",
            "nullable": true,
            "description": "Thread tolerance class (e.g., 6H, 6g)",
            "example": "6H"
          },
          "handedness": {
            "type": "string",
            "enum": ["right", "left"],
            "default": "right",
            "description": "Thread handedness (right-hand is default if not specified)"
          },
          "depth": {
            "type": "number",
            "nullable": true,
            "description": "Thread depth in mm (for blind holes)"
          },
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          }
        }
      },
      "Bore": {
        "type": "object",
        "description": "Bore/hole feature extracted from the drawing",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reference ID"
          },
          "diameter": {
            "type": "number",
            "description": "Bore diameter in mm"
          },
          "depth": {
            "type": "number",
            "nullable": true,
            "description": "Bore depth in mm (null for through holes)"
          },
          "type": {
            "type": "string",
            "enum": ["through", "blind", "counterbore", "countersink", "stepped"],
            "description": "Bore type"
          },
          "quantity": {
            "type": "integer",
            "default": 1,
            "description": "Number of identical bores (from pattern callouts like '4x')"
          },
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          }
        }
      },
      "Chamfer": {
        "type": "object",
        "description": "Chamfer feature",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reference ID"
          },
          "angle": {
            "type": "number",
            "description": "Chamfer angle in degrees",
            "example": 45
          },
          "depth": {
            "type": "number",
            "description": "Chamfer depth/leg length in mm",
            "example": 1.0
          },
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          }
        }
      },
      "Radius": {
        "type": "object",
        "description": "Radius feature",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reference ID"
          },
          "value": {
            "type": "number",
            "description": "Radius value in mm"
          },
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          }
        }
      },
      "SurfaceRoughness": {
        "type": "object",
        "description": "Surface roughness specification for a specific surface or area",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reference ID"
          },
          "parameter": {
            "type": "string",
            "enum": ["Ra", "Rz", "Rq", "Rt"],
            "description": "Roughness parameter type"
          },
          "value": {
            "type": "number",
            "description": "Roughness value in micrometers",
            "example": 1.6
          },
          "process": {
            "type": "string",
            "nullable": true,
            "description": "Manufacturing process indication (e.g., 'ground', 'turned', 'milled')"
          },
          "lay_direction": {
            "type": "string",
            "nullable": true,
            "description": "Surface lay direction symbol"
          },
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          }
        }
      },
      "FeatureControlFrame": {
        "type": "object",
        "description": "GD&T Feature Control Frame — specifies geometric tolerances per ASME Y14.5 / ISO 1101",
        "properties": {
          "id": {
            "type": "string",
            "description": "Reference ID"
          },
          "characteristic": {
            "type": "string",
            "enum": [
              "straightness",
              "flatness",
              "circularity",
              "cylindricity",
              "line_profile",
              "surface_profile",
              "angularity",
              "perpendicularity",
              "parallelism",
              "position",
              "concentricity",
              "symmetry",
              "circular_runout",
              "total_runout"
            ],
            "description": "Geometric characteristic symbol"
          },
          "tolerance_zone": {
            "type": "number",
            "description": "Tolerance zone width/diameter in mm",
            "example": 0.05
          },
          "tolerance_zone_shape": {
            "type": "string",
            "enum": ["diameter", "width", "spherical"],
            "nullable": true,
            "description": "Shape of the tolerance zone"
          },
          "material_condition": {
            "type": "string",
            "enum": ["MMC", "LMC", "RFS"],
            "nullable": true,
            "description": "Material condition modifier (Maximum Material Condition, Least Material Condition, Regardless of Feature Size)"
          },
          "datum_references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "datum": {
                  "type": "string",
                  "description": "Datum letter (A, B, C, etc.)",
                  "example": "A"
                },
                "material_condition": {
                  "type": "string",
                  "enum": ["MMC", "LMC", "RFS"],
                  "nullable": true
                }
              }
            },
            "description": "Ordered list of datum references (primary, secondary, tertiary)"
          },
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          }
        }
      },
      "InsightsResult": {
        "type": "object",
        "description": "Manufacturing insights derived from the drawing analysis",
        "properties": {
          "bounding_dimensions": {
            "type": "object",
            "description": "Overall bounding dimensions of the part",
            "properties": {
              "length": {
                "type": "number",
                "description": "Overall length in mm"
              },
              "width": {
                "type": "number",
                "description": "Overall width in mm"
              },
              "height": {
                "type": "number",
                "description": "Overall height in mm"
              }
            }
          },
          "estimated_volume": {
            "type": "number",
            "nullable": true,
            "description": "Estimated part volume in mm3 (approximation from 2D drawing)"
          },
          "manufacturing_methods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "description": "Manufacturing method name",
                  "example": "CNC Turning"
                },
                "confidence": {
                  "$ref": "#/components/schemas/Confidence"
                }
              }
            },
            "description": "Suggested primary manufacturing methods ranked by likelihood"
          },
          "secondary_processes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "process": {
                  "type": "string",
                  "description": "Secondary process name",
                  "example": "Heat Treatment"
                },
                "confidence": {
                  "$ref": "#/components/schemas/Confidence"
                }
              }
            },
            "description": "Suggested secondary/finishing processes"
          }
        }
      },
      "RedactionResult": {
        "type": "object",
        "description": "Redacted drawing output",
        "properties": {
          "redacted_drawing": {
            "type": "string",
            "format": "byte",
            "description": "Base64-encoded redacted drawing (same format as input)"
          },
          "redacted_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["logo", "proprietary_mark", "text_block"],
                  "description": "Type of redacted content"
                },
                "bounding_box": {
                  "$ref": "#/components/schemas/BoundingBox"
                }
              }
            },
            "description": "Regions that were redacted"
          }
        }
      },
      "BalloonsResult": {
        "type": "object",
        "description": "Extracted balloon/callout annotations",
        "properties": {
          "balloons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "description": "Balloon number"
                },
                "text": {
                  "type": "string",
                  "description": "Text content of the balloon"
                },
                "position": {
                  "$ref": "#/components/schemas/BoundingBox"
                },
                "feature_ref": {
                  "type": "string",
                  "nullable": true,
                  "description": "Reference ID linking to an extracted feature"
                }
              }
            }
          }
        }
      },
      "SheetImagesResult": {
        "type": "object",
        "description": "Thumbnail images of drawing sheets",
        "properties": {
          "sheets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sheet_number": {
                  "type": "integer",
                  "description": "Sheet number (1-based)"
                },
                "image": {
                  "type": "string",
                  "format": "byte",
                  "description": "Base64-encoded PNG thumbnail"
                },
                "width": {
                  "type": "integer",
                  "description": "Image width in pixels"
                },
                "height": {
                  "type": "integer",
                  "description": "Image height in pixels"
                }
              }
            }
          }
        }
      },
      "ViewImagesResult": {
        "type": "object",
        "description": "Thumbnail images of individual drawing views",
        "properties": {
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "view_type": {
                  "type": "string",
                  "description": "Type of view (e.g., 'front', 'side', 'top', 'section', 'detail', 'isometric')"
                },
                "label": {
                  "type": "string",
                  "nullable": true,
                  "description": "View label from the drawing (e.g., 'Section A-A', 'Detail B')"
                },
                "image": {
                  "type": "string",
                  "format": "byte",
                  "description": "Base64-encoded PNG thumbnail"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "BoundingBox": {
        "type": "object",
        "description": "Pixel-precise bounding box locating a feature on the drawing image",
        "properties": {
          "x": {
            "type": "number",
            "description": "X coordinate of top-left corner (pixels)"
          },
          "y": {
            "type": "number",
            "description": "Y coordinate of top-left corner (pixels)"
          },
          "width": {
            "type": "number",
            "description": "Box width (pixels)"
          },
          "height": {
            "type": "number",
            "description": "Box height (pixels)"
          },
          "page": {
            "type": "integer",
            "description": "Page/sheet number (0-based)"
          }
        }
      },
      "Confidence": {
        "type": "number",
        "format": "float",
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Confidence score for the extracted value (0.0 = no confidence, 1.0 = highest confidence). Values below 0.7 should be flagged for manual review.",
        "example": 0.95
      },
      "Error": {
        "type": "object",
        "description": "Standard error response",
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error description"
          },
          "details": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Additional error context"
          }
        }
      }
    }
  }
}